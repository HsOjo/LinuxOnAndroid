#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
DEVSRC=${DEVSRC:-/.oldroot/dev}
umask 022
mount -t tmpfs -o mode=0755 tmpfs /dev || true
mkdir -p /dev/pts /dev/net /dev/shm
chmod 1777 /dev/shm 2>/dev/null || true
rm -f /dev/null
mknod -m 666 /dev/null c 1 3
mknod -m 666 /dev/zero c 1 5 2>/dev/null || true
mknod -m 666 /dev/full c 1 7 2>/dev/null || true
mknod -m 644 /dev/random c 1 8 2>/dev/null || true
mknod -m 644 /dev/urandom c 1 9 2>/dev/null || true
mknod -m 666 /dev/tty c 5 0 2>/dev/null || true
mknod -m 600 /dev/console c 5 1 2>/dev/null || true
mount -t devpts -o newinstance,ptmxmode=666,mode=620,gid=5 devpts /dev/pts 2>/dev/null || mount -t devpts devpts /dev/pts 2>/dev/null || true
rm -f /dev/ptmx 2>/dev/null || true
if [ -e /dev/pts/ptmx ]; then
  ln -sf pts/ptmx /dev/ptmx 2>/dev/null || true
else
  mknod -m 666 /dev/ptmx c 5 2 2>/dev/null || true
fi
# Standard fd links every userland expects (FHS): shells, daemons, and
# container images (e.g. nginx:alpine symlinks /var/log/nginx/*.log to
# /dev/std*) all assume these exist. Native init systems create them
# (OpenRC devfs seed_dev, systemd mount-setup), but this chroot's PID 1 is
# container-init, so we must create them ourselves — otherwise programs
# opening /dev/std* with O_CREAT silently make a regular file here (or die
# with EROFS when this /dev is bind-mounted read-only into containers).
# -n: once /dev/fd exists it resolves to a directory; plain ln -sf would
# dereference it and try to create /dev/fd/fd.
ln -sfn /proc/self/fd   /dev/fd     2>/dev/null || true
ln -sfn /proc/self/fd/0 /dev/stdin  2>/dev/null || true
ln -sfn /proc/self/fd/1 /dev/stdout 2>/dev/null || true
ln -sfn /proc/self/fd/2 /dev/stderr 2>/dev/null || true
bind_node() {
  src="$DEVSRC${1#/dev}"
  dst="$1"
  [ -e "$src" ] || return 0
  mkdir -p "${dst%/*}" 2>/dev/null || true
  rm -f "$dst" 2>/dev/null || true
  : > "$dst" 2>/dev/null || true
  mount --bind "$src" "$dst" 2>/dev/null || true
}
for n in /dev/tun /dev/net/tun /dev/fuse; do
  bind_node "$n"
done
exit 0
