#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
if [ "${LOA_PROC_ISOLATED:-0}" != 1 ] && [ -x /usr/bin/python3 ]; then
  LOA_PROC_ISOLATED=1
  export LOA_PROC_ISOLATED
  exec /usr/bin/python3 - <<'PY'
import ctypes, os
CAP_SYS_PTRACE = 19
PR_CAPBSET_DROP = 24
libc = ctypes.CDLL(None, use_errno=True)
if libc.prctl(PR_CAPBSET_DROP, CAP_SYS_PTRACE, 0, 0, 0) != 0:
    err = ctypes.get_errno()
    raise OSError(err, os.strerror(err))
seen = set()
keep = []
for group in os.getgroups():
    if group == 3009 or group in seen:
        continue
    seen.add(group)
    keep.append(group)
for group in (3003, 3004):
    if group not in seen:
        seen.add(group)
        keep.append(group)
os.setgroups(keep or [0])
os.execv("/bin/sh", ["/bin/sh", "/sbin/boot-inner"])
PY
fi
mount -t proc -o hidepid=2,gid=3009 proc /proc 2>/dev/null || true
mount -t sysfs -o ro sysfs /sys 2>/dev/null || true
mkdir -p /sys/fs/cgroup 2>/dev/null || true
mount -t cgroup2 -o rw,nosuid,nodev,noexec,relatime cgroup2 /sys/fs/cgroup 2>/dev/null || true
DEVSRC=/.hostdev /sbin/setup-dev
umount -l /.hostdev 2>/dev/null || true
rmdir /.hostdev 2>/dev/null || true
mount -t tmpfs -o ro,mode=0555,nodev,nosuid,noexec tmpfs /.oldroot 2>/dev/null || true
if [ -f /etc/alpine-release ]; then
  [ -x /sbin/guest-init-alpine ] && /sbin/guest-init-alpine 2>/dev/null || true
elif [ -f /etc/debian_version ]; then
  [ -x /sbin/guest-init-debian ] && /sbin/guest-init-debian 2>/dev/null || true
fi
echo 800 > /proc/self/oom_score_adj 2>/dev/null || true
exec /sbin/container-init
